<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jetank_motor_control</name>
  <version>0.0.0</version>
  <description>Motor control and ros2_control hardware interface for the JeTank robot</description>
  <maintainer email="gorkom.projects@gmail.com">koen</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core ROS2 -->
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>pluginlib</depend>

  <!-- Messages compiled against (see CMakeLists find_package list) -->
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <!-- control_msgs is not compiled against here; it is the runtime action
       interface (GripperCommand) of the gripper_controller spawned from
       config/jetank_controllers.yaml -->
  <exec_depend>control_msgs</exec_depend>

  <!-- ros2_control (hardware_interface is compiled against; the controller
       stack is only needed at launch/run time) -->
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <depend>hardware_interface</depend>

  <!-- Controllers (runtime-only: spawned from config/jetank_controllers.yaml,
       never compiled against) -->
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>gripper_controllers</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>

  <!-- Gazebo simulation: config/ros2_control.xacro loads
       ign_ros2_control/IgnitionSystem when use_sim:=true (Gazebo Fortress;
       the workspace does not use Gazebo Classic) -->
  <exec_depend>ign_ros2_control</exec_depend>

  <!-- Robot description tooling (runtime-only: used by launch files) -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- Hardware interface plugin export (for future real hardware) -->
    <hardware_interface plugin="${prefix}/jetank_hardware.xml"/>
  </export>
</package>
